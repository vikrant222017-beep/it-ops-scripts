<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>PyAnalyst — Python Playground</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>
<style>
  :root {
    --bg: #f7f6f2;
    --surface: #ffffff;
    --surface2: #f0efe9;
    --border: #e2e0d8;
    --border2: #ccc9bc;
    --text: #1a1916;
    --text2: #6b6860;
    --text3: #9b9890;
    --accent: #1d6b4e;
    --accent-light: #e8f5f0;
    --accent2: #c85c2a;
    --accent2-light: #fdf1ec;
    --code-bg: #fafaf7;
    --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.05);
    --shadow-lg: 0 8px 32px rgba(0,0,0,0.10);
    --radius: 10px;
    --mono: 'DM Mono', monospace;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; background: var(--bg); color: var(--text); font-family: 'Lato', sans-serif; }

  /* ── HEADER ── */
  header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 28px; height: 58px;
    background: var(--surface); border-bottom: 1px solid var(--border);
    position: sticky; top: 0; z-index: 100;
  }
  .logo { display: flex; align-items: center; gap: 10px; }
  .logo-mark {
    width: 32px; height: 32px; border-radius: 8px;
    background: var(--accent); display: flex; align-items: center; justify-content: center;
  }
  .logo-mark svg { width: 18px; height: 18px; fill: #fff; }
  .logo-name { font-family: 'DM Serif Display', serif; font-size: 20px; letter-spacing: -0.3px; color: var(--text); }
  .logo-badge { font-size: 10px; font-weight: 700; letter-spacing: 1.5px; color: var(--accent); text-transform: uppercase; background: var(--accent-light); padding: 2px 7px; border-radius: 20px; margin-left: 4px; }
  #status-pill {
    display: flex; align-items: center; gap: 7px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.5px;
    color: var(--text2); background: var(--surface2);
    border: 1px solid var(--border); border-radius: 20px;
    padding: 5px 12px; transition: all 0.3s;
  }
  #status-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #d4b84a; transition: background 0.4s;
  }
  #status-dot.ready { background: var(--accent); }
  #status-dot.running { background: var(--accent2); animation: pulse 0.8s infinite; }

  @keyframes pulse { 0%,100% { opacity:1 } 50% { opacity:0.4 } }

  /* ── LAYOUT ── */
  .workspace {
    display: grid;
    grid-template-columns: 260px 1fr;
    grid-template-rows: 1fr;
    height: calc(100vh - 58px);
    overflow: hidden;
  }

  /* ── SIDEBAR ── */
  aside {
    background: var(--surface); border-right: 1px solid var(--border);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .sidebar-header {
    padding: 16px 18px 12px;
    border-bottom: 1px solid var(--border);
    font-size: 10px; font-weight: 700; letter-spacing: 1.8px;
    text-transform: uppercase; color: var(--text3);
  }
  .snippets-list { overflow-y: auto; flex: 1; padding: 8px; }
  .snippet-card {
    padding: 10px 12px; border-radius: 8px; cursor: pointer;
    border: 1px solid transparent; transition: all 0.18s;
    margin-bottom: 4px;
  }
  .snippet-card:hover { background: var(--surface2); border-color: var(--border); }
  .snippet-card.active { background: var(--accent-light); border-color: #a3d4c2; }
  .snippet-title { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
  .snippet-desc { font-size: 11px; color: var(--text3); line-height: 1.4; }
  .snippet-tag {
    display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: 1px;
    text-transform: uppercase; padding: 2px 6px; border-radius: 4px;
    margin-top: 5px; background: var(--surface2); color: var(--text3);
  }

  /* ── MAIN PANEL ── */
  main { display: flex; flex-direction: column; overflow: hidden; }

  /* ── EDITOR AREA ── */
  .editor-pane {
    flex: 0 0 auto; min-height: 220px; max-height: 50vh;
    background: var(--surface); border-bottom: 1px solid var(--border);
    display: flex; flex-direction: column;
  }
  .pane-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 16px; height: 40px;
    border-bottom: 1px solid var(--border);
    background: var(--surface2);
  }
  .pane-label {
    font-size: 10px; font-weight: 700; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--text3); display: flex; align-items: center; gap: 6px;
  }
  .pane-label::before { content:''; display:block; width:6px; height:6px; border-radius:50%; background: var(--accent2); }
  .pane-actions { display: flex; gap: 8px; align-items: center; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 14px; border-radius: 7px; border: none; cursor: pointer;
    font-family: 'Lato', sans-serif; font-size: 12px; font-weight: 700;
    letter-spacing: 0.3px; transition: all 0.18s;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: #175c41; }
  .btn-primary:active { transform: scale(0.97); }
  .btn-primary:disabled { background: var(--border2); color: #fff; cursor: not-allowed; }
  .btn-ghost { background: transparent; color: var(--text2); border: 1px solid var(--border); }
  .btn-ghost:hover { background: var(--surface2); border-color: var(--border2); }
  .btn svg { width: 13px; height: 13px; }

  #code-editor {
    flex: 1; resize: none; border: none; outline: none;
    font-family: var(--mono); font-size: 13.5px; line-height: 1.65;
    padding: 16px 20px; background: var(--code-bg); color: var(--text);
    tab-size: 4; -moz-tab-size: 4; overflow-y: auto;
    min-height: 180px;
  }

  /* ── OUTPUT AREA ── */
  .output-pane {
    flex: 1; display: flex; flex-direction: column; overflow: hidden;
    background: var(--surface);
  }
  .output-pane .pane-label::before { background: var(--accent); }
  #output-area {
    flex: 1; overflow-y: auto; padding: 16px 20px;
    font-family: var(--mono); font-size: 13px; line-height: 1.7;
    background: var(--code-bg);
  }
  .output-line { white-space: pre-wrap; word-break: break-word; }
  .output-line.stdout { color: var(--text); }
  .output-line.stderr { color: #c0392b; }
  .output-line.result { color: var(--accent); font-weight: 500; }
  .output-line.info { color: var(--text3); font-style: italic; }
  .output-line.separator { color: var(--border2); }

  .empty-output {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    height: 100%; gap: 10px; color: var(--text3);
  }
  .empty-output svg { width: 36px; height: 36px; opacity: 0.25; }
  .empty-output p { font-size: 13px; }

  /* ── RESIZE HANDLE ── */
  .resize-handle {
    height: 5px; cursor: ns-resize; background: var(--border);
    transition: background 0.2s;
  }
  .resize-handle:hover { background: var(--accent); }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 4px; }

  /* ── LOADER OVERLAY ── */
  #loader {
    position: fixed; inset: 0; background: rgba(247,246,242,0.92);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    z-index: 999; gap: 18px; backdrop-filter: blur(3px);
    transition: opacity 0.5s;
  }
  #loader.hidden { opacity: 0; pointer-events: none; }
  .loader-title { font-family: 'DM Serif Display', serif; font-size: 26px; color: var(--text); }
  .loader-sub { font-size: 13px; color: var(--text3); }
  .loader-bar-wrap { width: 220px; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
  .loader-bar { height: 100%; width: 0%; background: var(--accent); border-radius: 2px; transition: width 0.4s ease; }

  /* ── TOOLTIP ── */
  [data-tip] { position: relative; }
  [data-tip]:hover::after {
    content: attr(data-tip);
    position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    background: var(--text); color: #fff; font-size: 11px; white-space: nowrap;
    padding: 4px 9px; border-radius: 5px; pointer-events: none;
  }

  .kbd {
    display: inline-block; font-family: var(--mono); font-size: 10px;
    background: var(--surface2); border: 1px solid var(--border2);
    border-radius: 4px; padding: 1px 5px; color: var(--text2);
  }
</style>
</head>
<body>

<!-- LOADER -->
<div id="loader">
  <div class="logo-mark" style="width:48px;height:48px;border-radius:12px;">
    <svg viewBox="0 0 24 24" style="width:26px;height:26px;fill:#fff"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>
  </div>
  <div class="loader-title">PyAnalyst</div>
  <div class="loader-sub" id="loader-msg">Loading Python runtime…</div>
  <div class="loader-bar-wrap"><div class="loader-bar" id="loader-bar"></div></div>
</div>

<!-- HEADER -->
<header>
  <div class="logo">
    <div class="logo-mark">
      <svg viewBox="0 0 24 24"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>
    </div>
    <span class="logo-name">PyAnalyst</span>
    <span class="logo-badge">Playground</span>
  </div>
  <div id="status-pill">
    <span id="status-dot"></span>
    <span id="status-text">Loading…</span>
  </div>
</header>

<!-- WORKSPACE -->
<div class="workspace">

  <!-- SIDEBAR -->
  <aside>
    <div class="sidebar-header">Snippet Library</div>
    <div class="snippets-list" id="snippets-list"></div>
  </aside>

  <!-- MAIN -->
  <main>
    <!-- EDITOR -->
    <div class="editor-pane" id="editor-pane">
      <div class="pane-bar">
        <span class="pane-label">Editor</span>
        <div class="pane-actions">
          <span class="kbd">Ctrl+Enter</span>&nbsp;to run
          <button class="btn btn-ghost" id="clear-btn" data-tip="Clear editor">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
            Clear
          </button>
          <button class="btn btn-primary" id="run-btn" disabled>
            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Run
          </button>
        </div>
      </div>
      <textarea id="code-editor" spellcheck="false" placeholder="# Write your Python code here…
print('Hello, analyst!')"></textarea>
    </div>

    <!-- RESIZE -->
    <div class="resize-handle" id="resize-handle"></div>

    <!-- OUTPUT -->
    <div class="output-pane">
      <div class="pane-bar">
        <span class="pane-label" style="--c:var(--accent)">Output</span>
        <div class="pane-actions">
          <button class="btn btn-ghost" id="clear-out-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Clear output
          </button>
        </div>
      </div>
      <div id="output-area">
        <div class="empty-output" id="empty-hint">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 12h8M8 8h5M8 16h3"/></svg>
          <p>Run code to see output here</p>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
// ── SNIPPETS DATA ──
const SNIPPETS = [
  {
    title: "Hello World",
    desc: "Basic print & variables",
    tag: "basics",
    code: `# Basic Python for analysts
name = "PyAnalyst"
version = 1.0
items = [10, 20, 30, 40, 50]

print(f"Welcome to {name} v{version}")
print(f"Sum: {sum(items)}")
print(f"Mean: {sum(items)/len(items)}")
print(f"Max: {max(items)}, Min: {min(items)}")`
  },
  {
    title: "List Comprehension",
    desc: "Filter, transform, and map data",
    tag: "data",
    code: `# List comprehension patterns
data = [15, 3, 42, 8, 99, 27, 6, 55, 12, 88]

evens = [x for x in data if x % 2 == 0]
squared = [x**2 for x in data if x < 30]
normalized = [round((x - min(data)) / (max(data) - min(data)), 3) for x in data]

print("Original:  ", data)
print("Evens:     ", evens)
print("Squared<30:", squared)
print("Normalized:", normalized)`
  },
  {
    title: "Dict Operations",
    desc: "Grouping, counting, sorting",
    tag: "data",
    code: `# Dictionary operations for data analysis
sales = {"Jan":12000,"Feb":9800,"Mar":15400,"Apr":13200,"May":17800,"Jun":16500}

total = sum(sales.values())
avg = total / len(sales)
best_month = max(sales, key=sales.get)
worst_month = min(sales, key=sales.get)

print(f"Total Revenue : ₹{total:,}")
print(f"Monthly Avg   : ₹{avg:,.0f}")
print(f"Best Month    : {best_month} (₹{sales[best_month]:,})")
print(f"Worst Month   : {worst_month} (₹{sales[worst_month]:,})")
print()
print("Sorted by revenue:")
for m, v in sorted(sales.items(), key=lambda x: x[1], reverse=True):
    bar = "█" * (v // 1000)
    print(f"  {m}: {bar} ₹{v:,}")`
  },
  {
    title: "Statistics",
    desc: "Mean, median, std deviation",
    tag: "stats",
    code: `import statistics

scores = [88, 92, 79, 95, 84, 71, 90, 87, 93, 76, 88, 82]

print("=== Descriptive Statistics ===")
print(f"Count    : {len(scores)}")
print(f"Mean     : {statistics.mean(scores):.2f}")
print(f"Median   : {statistics.median(scores)}")
print(f"Mode     : {statistics.mode(scores)}")
print(f"Std Dev  : {statistics.stdev(scores):.2f}")
print(f"Variance : {statistics.variance(scores):.2f}")
print(f"Min/Max  : {min(scores)} / {max(scores)}")
print(f"Range    : {max(scores) - min(scores)}")

# Quartiles
sorted_s = sorted(scores)
n = len(sorted_s)
q1 = statistics.median(sorted_s[:n//2])
q3 = statistics.median(sorted_s[n//2:])
iqr = q3 - q1
print(f"Q1 / Q3  : {q1} / {q3}")
print(f"IQR      : {iqr}")`
  },
  {
    title: "String Parsing",
    desc: "Clean & parse text data",
    tag: "cleaning",
    code: `# Common string cleaning for data analysts
raw_data = [
    "  John Doe | 34 | Sales  ",
    "jane smith | 28 | ENGINEERING",
    "BOB MARTIN|41|hr",
    "  Alice Wong | 25 | Product  "
]

cleaned = []
for row in raw_data:
    parts = [p.strip() for p in row.split("|")]
    name = parts[0].title()
    age = int(parts[1])
    dept = parts[2].title()
    cleaned.append({"name": name, "age": age, "dept": dept})

print(f"{'Name':<15} {'Age':>4}  {'Department'}")
print("-" * 35)
for r in cleaned:
    print(f"{r['name']:<15} {r['age']:>4}  {r['dept']}")

avg_age = sum(r['age'] for r in cleaned) / len(cleaned)
print(f"\nAverage age: {avg_age:.1f}")`
  },
  {
    title: "File Simulation",
    desc: "Read & process CSV-like data",
    tag: "io",
    code: `import io, csv

# Simulate a CSV in memory
raw_csv = """product,category,price,units
Laptop Pro,Electronics,85000,12
Wireless Mouse,Electronics,1200,145
Standing Desk,Furniture,22000,8
Monitor 27",Electronics,18000,34
Ergonomic Chair,Furniture,15000,19
USB Hub,Electronics,850,210
Bookshelf,Furniture,6500,27"""

reader = csv.DictReader(io.StringIO(raw_csv))
rows = list(reader)

print(f"{'Product':<20} {'Category':<14} {'Price':>8}  {'Units':>6}  {'Revenue':>10}")
print("─" * 68)

by_category = {}
for r in rows:
    price, units = int(r['price']), int(r['units'])
    rev = price * units
    cat = r['category']
    by_category.setdefault(cat, 0)
    by_category[cat] += rev
    print(f"{r['product']:<20} {cat:<14} {price:>8,}  {units:>6}  {rev:>10,}")

print("─" * 68)
print("\nRevenue by Category:")
for cat, rev in sorted(by_category.items(), key=lambda x: -x[1]):
    print(f"  {cat:<14}: ₹{rev:,}")`
  },
  {
    title: "Date & Time",
    desc: "Parse, diff, format dates",
    tag: "time",
    code: `from datetime import datetime, timedelta

# Common date operations for analysts
today = datetime.today()
dates_raw = ["2024-01-15", "2024-03-22", "2024-06-01", "2024-09-10", "2024-11-30"]

print(f"Today: {today.strftime('%d %B %Y')}\n")
print(f"{'Date':<14} {'Day':<12} {'Days Ago':>9}  {'Quarter':>8}")
print("─" * 50)

for d in dates_raw:
    dt = datetime.strptime(d, "%Y-%m-%d")
    days_ago = (today - dt).days
    quarter = (dt.month - 1) // 3 + 1
    print(f"{dt.strftime('%d %b %Y'):<14} {dt.strftime('%A'):<12} {days_ago:>9}  {'Q'+str(quarter):>8}")

# Date range generation
print("\n30-day schedule (every 7 days):")
start = today
for i in range(5):
    d = start + timedelta(weeks=i)
    print(f"  Week {i+1}: {d.strftime('%d %b %Y (%A)')}")`
  },
  {
    title: "Error Handling",
    desc: "Robust try/except patterns",
    tag: "patterns",
    code: `# Robust data processing with error handling
raw_inputs = ["42", "3.14", "NaN", "", "100", "abc", "0", None, "999"]

def safe_parse(val):
    if val is None:
        return None, "null value"
    val = str(val).strip()
    if not val:
        return None, "empty string"
    try:
        num = float(val)
        if num != num:  # NaN check
            return None, "NaN"
        return num, "ok"
    except ValueError:
        return None, f"cannot parse '{val}'"

results = []
errors = []
print(f"{'Input':<10} {'Result':<12} {'Status'}")
print("─" * 38)
for inp in raw_inputs:
    val, status = safe_parse(inp)
    flag = "✓" if status == "ok" else "✗"
    print(f"{str(inp):<10} {str(val):<12} {flag} {status}")
    if val is not None:
        results.append(val)
    else:
        errors.append(inp)

print(f"\nParsed {len(results)} values, {len(errors)} errors")
if results:
    print(f"Valid avg : {sum(results)/len(results):.2f}")`
  },
];

// ── GLOBALS ──
let pyodide = null;
let isRunning = false;
let activeSnippet = null;

// ── LOAD PYODIDE ──
async function loadPyodideRuntime() {
  const bar = document.getElementById('loader-bar');
  const msg = document.getElementById('loader-msg');

  msg.textContent = "Initialising Python (Pyodide)…";
  bar.style.width = "20%";

  pyodide = await loadPyodide({ indexURL: "https://cdn.jsdelivr.net/pyodide/v0.25.0/full/" });

  bar.style.width = "70%";
  msg.textContent = "Setting up environment…";

  // Redirect stdout/stderr
  await pyodide.runPythonAsync(`
import sys, io
class _Capture:
    def __init__(self, kind):
        self.kind = kind
        self.buf = []
    def write(self, s):
        if s:
            self.buf.append((self.kind, s))
    def flush(self): pass
_stdout_cap = _Capture('stdout')
_stderr_cap = _Capture('stderr')
sys.stdout = _stdout_cap
sys.stderr = _stderr_cap
`);

  bar.style.width = "100%";
  msg.textContent = "Ready!";
  await new Promise(r => setTimeout(r, 400));

  document.getElementById('loader').classList.add('hidden');
  setStatus('ready', 'Python Ready');
  document.getElementById('run-btn').disabled = false;
}

function setStatus(state, text) {
  const dot = document.getElementById('status-dot');
  const txt = document.getElementById('status-text');
  dot.className = state;
  txt.textContent = text;
}

// ── SNIPPET SIDEBAR ──
function buildSidebar() {
  const list = document.getElementById('snippets-list');
  list.innerHTML = '';
  SNIPPETS.forEach((s, i) => {
    const el = document.createElement('div');
    el.className = 'snippet-card';
    el.innerHTML = `<div class="snippet-title">${s.title}</div>
      <div class="snippet-desc">${s.desc}</div>
      <span class="snippet-tag">${s.tag}</span>`;
    el.addEventListener('click', () => loadSnippet(i, el));
    list.appendChild(el);
  });
}

function loadSnippet(idx, el) {
  if (activeSnippet) activeSnippet.classList.remove('active');
  el.classList.add('active');
  activeSnippet = el;
  document.getElementById('code-editor').value = SNIPPETS[idx].code;
}

// ── OUTPUT ──
function appendOutput(lines) {
  const area = document.getElementById('output-area');
  const empty = document.getElementById('empty-hint');
  if (empty) empty.remove();

  lines.forEach(([kind, text]) => {
    const div = document.createElement('div');
    div.className = `output-line ${kind}`;
    div.textContent = text;
    area.appendChild(div);
  });
  area.scrollTop = area.scrollHeight;
}

function clearOutput() {
  const area = document.getElementById('output-area');
  area.innerHTML = `<div class="empty-output" id="empty-hint">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 12h8M8 8h5M8 16h3"/></svg>
    <p>Run code to see output here</p>
  </div>`;
}

// ── RUN CODE ──
async function runCode() {
  if (isRunning || !pyodide) return;
  const code = document.getElementById('code-editor').value.trim();
  if (!code) return;

  isRunning = true;
  setStatus('running', 'Running…');
  document.getElementById('run-btn').disabled = true;

  // timestamp separator
  const now = new Date();
  appendOutput([['separator', `─── Run ${now.toLocaleTimeString()} ${'─'.repeat(30)}`]]);

  try {
    // clear capture buffers
    await pyodide.runPythonAsync(`_stdout_cap.buf.clear(); _stderr_cap.buf.clear()`);

    const result = await pyodide.runPythonAsync(code);

    // get captured output
    const stdoutBuf = pyodide.globals.get('_stdout_cap').buf.toJs();
    const stderrBuf = pyodide.globals.get('_stderr_cap').buf.toJs();

    const lines = [];
    stdoutBuf.forEach(item => {
      const arr = item.toJs ? item.toJs() : item;
      lines.push([arr[0], arr[1]]);
    });
    stderrBuf.forEach(item => {
      const arr = item.toJs ? item.toJs() : item;
      lines.push([arr[0], arr[1]]);
    });

    if (lines.length === 0 && result !== undefined && result !== null) {
      lines.push(['result', String(result)]);
    }
    if (lines.length === 0) {
      lines.push(['info', '(no output)']);
    }
    appendOutput(lines);

  } catch (err) {
    appendOutput([['stderr', err.message]]);
  }

  isRunning = false;
  setStatus('ready', 'Python Ready');
  document.getElementById('run-btn').disabled = false;
}

// ── RESIZE HANDLE ──
(function () {
  const handle = document.getElementById('resize-handle');
  const pane = document.getElementById('editor-pane');
  let dragging = false, startY = 0, startH = 0;
  handle.addEventListener('mousedown', e => {
    dragging = true; startY = e.clientY; startH = pane.offsetHeight;
    document.body.style.cursor = 'ns-resize'; e.preventDefault();
  });
  window.addEventListener('mousemove', e => {
    if (!dragging) return;
    const delta = e.clientY - startY;
    const newH = Math.max(120, Math.min(window.innerHeight * 0.7, startH + delta));
    pane.style.height = newH + 'px';
    pane.style.flex = 'none';
  });
  window.addEventListener('mouseup', () => { dragging = false; document.body.style.cursor = ''; });
})();

// ── EVENT LISTENERS ──
document.getElementById('run-btn').addEventListener('click', runCode);
document.getElementById('clear-btn').addEventListener('click', () => {
  document.getElementById('code-editor').value = '';
  if (activeSnippet) { activeSnippet.classList.remove('active'); activeSnippet = null; }
});
document.getElementById('clear-out-btn').addEventListener('click', clearOutput);

document.getElementById('code-editor').addEventListener('keydown', e => {
  if (e.key === 'Tab') {
    e.preventDefault();
    const ta = e.target;
    const start = ta.selectionStart, end = ta.selectionEnd;
    ta.value = ta.value.substring(0, start) + '    ' + ta.value.substring(end);
    ta.selectionStart = ta.selectionEnd = start + 4;
  }
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
    e.preventDefault(); runCode();
  }
});

// ── INIT ──
buildSidebar();
loadPyodideRuntime();
</script>
